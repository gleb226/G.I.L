# G.I.L Apartments — Environment Variables
# Copy this file to .env and fill in your values

# ─── Telegram Bot ───
BOT_TOKEN=

# ─── MongoDB ───
MONGODB_URI=

# ─── Monobank Payment (Merchant API) ───
# Test token — replace with production token before going live
MONOBANK_TOKEN=u9mxshTrEIUIwo-IEe1uOk-3GE03S3iBlcoB_CuEc_3Q

# ─── Google Maps ───
GOOGLE_MAPS_API_KEY=

# ─── Roles ───
# Boss / Owner IDs (comma-separated, e.g.: 123456789,987654321)
BOSS_IDS=

# Manager IDs (comma-separated)
MANAGER_IDS=

# Developer IDs are hard-coded in Bot/app/common/token.py (DEV_IDS list)

# ─── Admin Panel ───
ADMIN_PASSWORD=

# ─── Currency ───
USD_RATE=42.0

# ─── Server ───
PORT=8000
